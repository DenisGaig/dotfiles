@import "shared/mocha.rasi"
@import "shared/fonts.rasi"

* {
    background:                  @base;
    background-alt:              @surface0;
    foreground:                  @text;
    selected:                    @mauve;
    border-col:                  @surface2;
    accent:                      @green;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    southeast;
    anchor:                      center;
    fullscreen:                  false;
    width:                       750px;
    height:                      260px;
    x-offset:                    -15px;
    y-offset:                    -15px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               20px;
    border-color:                @border-col;
    background-color:            @base;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     15px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px 22px;
    border:                      0px solid;
    border-radius:               15px;
    border-color:                @selected;
    background-color:            @surface0;
    text-color:                  @text;
    children:                    [ "entry" ];
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search clipboard history...";
    placeholder-color:           @overlay0;
    font:                        "FiraCode Nerd Font 11";
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       9;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     6px;
    margin:                      0px;
    padding:                     4px 10px 4px 4px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

scrollbar {
    width:                       8px;
    handle-width:                8px;
    handle-color:                @accent;
    border-radius:               10px;
    background-color:            @surface0;
    margin:                      0px 0px 0px 8px;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     5px 14px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
    orientation:                 horizontal;
    children:                    [ "element-text" ];
}

element normal.normal {
    background-color:            @surface0;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @accent;
    text-color:                  @crust;
    border:                      2px solid;
    border-color:                @accent;
}

element alternate.normal {
    background-color:            @surface2;
    text-color:                  @foreground;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    padding:                     0px;
    font:                        "FiraCode Nerd Font 10";
}

/*****----- Message -----*****/
error-message {
    padding:                     20px;
    border:                      2px solid;
    border-radius:               20px;
    border-color:                @red;
    background-color:            @background;
    text-color:                  @foreground;
}

textbox {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}
